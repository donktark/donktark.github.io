      <guid>https://donktark.github.io/latest/en/docs/body_text/body_post2/</guid>
      <description>
        
        
        &lt;h2&gt;Chart insertion&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;chart-insertion&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#chart-insertion&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&lt;p&gt;차트 삽입하기&lt;/p&gt;
&lt;h3&gt;Bar chart&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;bar-chart&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#bar-chart&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;script src=&#34;https://cdn.jsdelivr.net/npm/chart.js&#34;&gt;&lt;/script&gt;
&lt;script&gt; Chart.defaults.color = &#39;#bcbcbc&#39;; &lt;/script&gt;&lt;div class=&#34;chart&#34;&gt;
    &lt;canvas id=&#34;2cbd99206c163d09&#34;&gt;&lt;/canvas&gt;
&lt;/div&gt;
&lt;script&gt;
    document.addEventListener(&#39;DOMContentLoaded&#39;, () =&gt; {
        var ctx = document.getElementById(&#39;2cbd99206c163d09&#39;)
        var options = 
{
    type: &#39;bar&#39;,
    data: {
        labels: [
            &#39;Red&#39;,
            &#39;Blue&#39;,
            &#39;Green&#39;
        ],
        datasets: [{
            label : &#39;Bar value&#39;,
            data: [6, 11, 9],
            backgroundColor: [
                &#39;rgb(255, 2, 15)&#39;,
                &#39;rgb(2, 68, 255)&#39;,
                &#39;rgb(18,213,3)&#39;
            ]
        }]
    },
    options: {}
};
        new Chart(ctx, options);
    });
&lt;/script&gt;
&lt;h3&gt;Doughnut chart&lt;span class=&#34;hx:absolute hx:-mt-20&#34; id=&#34;doughnut-chart&#34;&gt;&lt;/span&gt;
    &lt;a href=&#34;#doughnut-chart&#34; class=&#34;subheading-anchor&#34; aria-label=&#34;Permalink for this section&#34;&gt;&lt;/a&gt;&lt;/h3&gt;&lt;div class=&#34;chart&#34;&gt;
